# Copy to .env (never commit .env) or set these on the server.
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection string. The default matches docker-compose.yml.
# On AWS this points to RDS and the password comes from a secret, never git.
DATABASE_URL=postgresql+psycopg://showroom:showroom@localhost:5432/showroom

# OpenRouteService API key (free at openrouteservice.org, served from api.heigit.org), used by the trip
# planner for place search and road routes. On AWS it comes from Parameter Store.
ORS_API_KEY=
